{
  "name": "brand-deviation-engine",
  "version": "0.1.0",
  "description": "Deviation-detection engine: diffs a running app's resolved styles against a brand token spec.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "report": "npm run build && node dist/src/cli.js",
    "validate": "npm run build && node dist/src/validate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@carbon/colors": "^11.55.0",
    "@carbon/layout": "^11.56.0",
    "@carbon/themes": "^11.78.0",
    "@playwright/test": "^1.47.0",
    "@primer/primitives": "^11.10.0",
    "@types/node": "^20.14.0",
    "playwright": "^1.47.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
